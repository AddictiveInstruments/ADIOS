################################################################################
# following setup is static for DIPCOREF4 module
################################################################################

PROCESSOR =		STM32G050K8
FAMILY    = 	STM32G0xx
BOARD	  = 	STM32G050K8
LCD       =     dummy

################################################################################
# Source Files, include paths and libraries
################################################################################

THUMB_SOURCE    = $(MIOS32_PATH)/etc/startup/STM32G0xx/startup_stm32g050.c \
				main.c \
				bsl_sysex.c

# (following source stubs not relevant for Cortex M0+ derivatives)
THUMB_AS_SOURCE =
ARM_SOURCE      =
ARM_AS_SOURCE   =

C_INCLUDE = 	-I .
A_INCLUDE = 	-I .

LIBS =


################################################################################
# Remaining variables
################################################################################

# generated by etc/gen_bsl_boundary.sh on every build, fixed name so
# switching chips overwrites rather than accumulates copies (see that
# script's header comment)
LD_FILE   = 	cpu_bsl.ld
PROJECT   = 	project

DEBUG     =	-g
OPTIMIZE  =	-Os

CFLAGS =	$(DEBUG) $(OPTIMIZE)


################################################################################
# Include source modules via additional makefiles
################################################################################

# add MIOS32 sources
include $(MIOS32_PATH)/mios32/mios32.mk

# common make rules
include $(MIOS32_PATH)/include/makefile/common.mk
