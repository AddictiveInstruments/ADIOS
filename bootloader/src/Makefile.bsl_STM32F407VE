# $Id: Makefile.bsl_MBHP_CORE_STM32 562 2009-05-22 22:35:29Z tk $

################################################################################
# following setup is static for the STM32F407VE bootloader (Waveshare F407VE
# test board - see apps/Bruno/f407_test). BOARD stays MBHP_DIPCOREF4: F4xx
# never gets its own per-board #ifdef chain, one fixed default for all
# STM32F4xx hardware (see mios32/STM32F4xx/mios32_board.c).
################################################################################


PROCESSOR =		STM32F407VE
MIOS32_PROCESSOR_STM32F407VE = DEFINED
FAMILY    = 	STM32F4xx
MIOS32_FAMILY_STM32F4xx = DEFINED
BOARD	  = 	MBHP_DIPCOREF4
MIOS32_BOARD_MBHP_DIPCOREF4 = DEFINED
LCD       =     dummy


################################################################################
# Source Files, include paths and libraries
################################################################################

THUMB_SOURCE    = $(MIOS32_PATH)/etc/startup/STM32F4xx/startup_stm32f4xx.c \
				main.c \
				bsl_sysex.c

# (following source stubs not relevant for Cortex M3 derivatives)
THUMB_AS_SOURCE =
ARM_SOURCE      =
ARM_AS_SOURCE   =

C_INCLUDE = 	-I .
A_INCLUDE = 	-I .

LIBS =


################################################################################
# Remaining variables
################################################################################

# generated by etc/gen_bsl_boundary.sh on every build, fixed name so
# switching chips overwrites rather than accumulates copies, inside
# project_build/ so it stays with the rest of this build's generated
# output rather than cluttering this source directory (see that script's
# header comment)
LD_FILE   = 	project_build/cpu_bsl.ld
PROJECT   = 	project

DEBUG     =	-g
OPTIMIZE  =	-Os

CFLAGS =	$(DEBUG) $(OPTIMIZE)


################################################################################
# Include source modules via additional makefiles
################################################################################

# add MIOS32 sources
include $(MIOS32_PATH)/mios32/mios32.mk

# common make rules
include $(MIOS32_PATH)/include/makefile/common.mk
