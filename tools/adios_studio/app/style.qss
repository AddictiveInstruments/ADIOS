/* The charter, shared with the updater, the screen tool and the ROM editor:
   slate ground, inset surfaces darker than what surrounds them, one accent
   blue for the single action that matters. */

QWidget {
    background: #1c212b;
    color: #dfe4ec;
    font-size: 12px;
}

QLabel#link, QLabel#lblMonIn, QLabel#lblMonOut { color: #8a94a6; }

QGroupBox {
    border: 1px solid #2a2f3a;
    border-radius: 4px;
    margin-top: 10px;
    padding: 15px;                /* symmetric - listbox border sits under the title's first letter */
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;                   /* title stays where it was */
    padding: 0 4px;
    color: #8a94a6;
}

QComboBox, QSpinBox, QLineEdit {
    background: #161a22;
    border: 1px solid #3d4757;
    border-radius: 2px;
    padding: 3px 8px;
    selection-background-color: #4a7ab8;
}
QComboBox::drop-down { border: none; width: 18px; }
/* Drop-down list. Dressing the VIEW alone is not enough: the item delegate paints
   every row from the palette, so the rows themselves have to be given their colours
   or they come out on the light default ground. */
QComboBox QAbstractItemView {
    background: #161a22;
    color: #dfe4ec;
    border: 1px solid #3d4757;
    outline: 0;
    selection-background-color: #2c4a6e;
    selection-color: #f2f6fc;
}
QComboBox QAbstractItemView::item          { background: #161a22; color: #dfe4ec; padding: 3px 8px; min-height: 18px; }
QComboBox QAbstractItemView::item:selected { background: #2c4a6e; color: #f2f6fc; }
QComboBox QAbstractItemView::item:disabled { color: #5a6172; }
QComboBox::down-arrow {           /* a real image: the CSS border-triangle renders as a block in Qt */
    image: url(:/app/arrow_down.png);
    width: 12px; height: 7px;
}
QComboBox QLineEdit {             /* editable combo: editor blends into the frame, no double border */
    background: transparent; border: none; padding: 0;
    selection-background-color: #4a7ab8;
}

/* Device ID spinner: the same little triangles as the combo, a touch smaller. */
QSpinBox::up-button   { subcontrol-origin: border; subcontrol-position: top right;    background: transparent; border: none; width: 16px; }
QSpinBox::down-button { subcontrol-origin: border; subcontrol-position: bottom right; background: transparent; border: none; width: 16px; }
QSpinBox::up-arrow    { image: url(:/app/arrow_up.png);   width: 9px; height: 5px; }
QSpinBox::down-arrow  { image: url(:/app/arrow_down.png); width: 9px; height: 5px; }

/* Menu bar (Tools / View) reserved at the top of the window. */
QMenuBar { background: #161a22; border-bottom: 1px solid #2a2f3a; }
QMenuBar::item { background: transparent; padding: 5px 10px; color: #b9c1cf; }
QMenuBar::item:selected { background: #2c4a6e; color: #f2f6fc; }
QMenuBar::item:pressed  { background: #2c4a6e; color: #f2f6fc; }

/* Right-click menus AND the menu-bar drop-downs: subtle hover highlight. */
QMenu { background: #1c212b; border: 1px solid #2a2f3a; }
QMenu::item { padding: 4px 18px; }
QMenu::item:selected { background: #2c4a6e; color: #f2f6fc; }
QMenu::item:disabled { color: #5a6172; }   /* grayed: the global QWidget color would otherwise keep it bright */
QMenu::separator { height: 1px; background: #2a2f3a; margin: 4px 8px; }
QMenu::indicator { width: 13px; height: 13px; }

QListWidget {
    background: #12151c;
    border: 1px solid #2a2f3a;
    border-radius: 3px;
    padding: 0;              /* no frame padding: the scrollbars sit flush to the border */
    outline: 0;
}
QListWidget#devInfo, QListWidget#uploadStatus, QListWidget#term,
QListWidget#monIn, QListWidget#monOut {
    font-family: "Consolas", "Menlo", monospace;
    font-size: 12px;
}
QListWidget::item { padding: 0 4px; }   /* text inset lives on the item, not the frame */
QListWidget::item:selected { background: #2c4a6e; color: #f2f6fc; }

QPushButton {
    background: #2e3644;
    border: 1px solid #3d4757;
    border-radius: 2px;
    padding: 4px 16px;
    outline: 0;              /* no dotted focus rectangle when the button keeps focus */
}
QPushButton:hover   { background: #39435a; }
QPushButton:pressed { background: #262d38; }
QPushButton:disabled { background: #242a34; border-color: #2e3644; color: #5a6172; }

QPushButton#connectBtn, QPushButton#uploadBtn {
    background: #4a7ab8;
    border: 1px solid #5a8ac8;
    color: #f2f6fc;
}
QPushButton#connectBtn:hover,    QPushButton#uploadBtn:hover    { background: #5686c4; }
QPushButton#connectBtn:pressed,  QPushButton#uploadBtn:pressed  { background: #3d6aa4; }
QPushButton#connectBtn:disabled, QPushButton#uploadBtn:disabled { background: #2f3a4a; border-color: #34404f; color: #5a6172; }

QPushButton#browseBtn, QPushButton#sendBtn {
    background: transparent;
    border: 1px solid #3d4757;
    color: #b9c1cf;
}
QPushButton#browseBtn:hover, QPushButton#sendBtn:hover { background: #232a35; color: #dfe4ec; }

QProgressBar {
    background: #12151c;
    border: 1px solid #2a2f3a;
    border-radius: 2px;
    height: 14px;
    text-align: center;
    color: #dfe4ec;
}
QProgressBar::chunk { background: #4a7ab8; border-radius: 2px; }

QCheckBox { color: #8a94a6; spacing: 4px; }

/* --- Input filter tree --- */
QToolButton { background: transparent; border: none; }   /* the disclosure triangles */
QLabel#filterLabel { color: #8a94a6; }   /* parent-level label */
QLabel#filterSub   { color: #5a6172; }   /* sub-filter label (child), e.g. Channels */

/* filter checkboxes are painted by FilterCheckBox (border + white tick, no fill) */

/* channel matrix cells: green/red border + fill kept; number dims when inactive */
QPushButton#chanBtn {
    padding: 0; font-size: 9px;
    border: 1px solid #e0666b; border-radius: 2px;
    background: transparent; color: #5a6172;      /* inactive: no fill, just the red outline */
}
QPushButton#chanBtn:checked  { border-color: #55b56a; background: #23331f; color: #eef3ea; }
QPushButton#chanBtn:disabled { border-color: #3a3f4a; color: #5a6172; background: transparent; }

/* Left Hand: wheel captions in the normal label colour (like "Channel:"),
   value read-outs in the accent, monospace */
QLabel#wheelLbl { color: #dfe4ec; }
QLabel#wheelVal { color: #5a8ac8; font-family: "Consolas", "Menlo", monospace; }

/* keyboard TX-channel cells: single-select, normal accent (blue) instead of green/red */
QPushButton#kbChan {
    padding: 0; font-size: 9px;
    border: 1px solid #3d4757; border-radius: 2px;
    background: transparent; color: #8a94a6;
}
QPushButton#kbChan:hover   { border-color: #5a8ac8; }
QPushButton#kbChan:checked { border-color: #5a8ac8; background: #4a7ab8; color: #f2f6fc; }

/* Set all / Clear all */
QPushButton#miniBtn {
    background: transparent; border: 1px solid #3d4757; border-radius: 2px;
    padding: 0 6px; font-size: 10px; color: #8a94a6;
}
QPushButton#miniBtn:hover    { background: #232a35; color: #dfe4ec; }
QPushButton#miniBtn:disabled { border-color: #2e3644; color: #5a6172; }

/* Handles are invisible at rest - they show the window ground between blocks -
   and only light up under the mouse. Same 4 px thickness both ways. */
QSplitter::handle            { background: transparent; }
QSplitter::handle:horizontal { width: 4px; }
QSplitter::handle:vertical   { height: 4px; }
QSplitter::handle:hover      { background: #4a5566; }

/* Scrollbars: horizontal and vertical styled identically. The groove is a plain
   very light grey - it replaces the native dithered "checkerboard" that leaked
   through on the unstyled (horizontal) bar and the scroll-area corner. Arrows
   and page steps are flattened so nothing native shows. */
QScrollBar:vertical   { background: #cdd2da; width: 10px;  margin: 0; border: none; }
QScrollBar:horizontal { background: #cdd2da; height: 10px; margin: 0; border: none; }
QScrollBar::handle:vertical   { background: #3d4757; border-radius: 5px; min-height: 20px; }
QScrollBar::handle:horizontal { background: #3d4757; border-radius: 5px; min-width: 20px; }
QScrollBar::handle:hover { background: #4a5566; }
QScrollBar::add-line:vertical,   QScrollBar::sub-line:vertical   { height: 0; width: 0; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
/* The little square where the two scrollbars meet is NOT a scrollbar: it takes
   the window ground, not the grey groove colour. */
QAbstractScrollArea::corner, QListWidget::corner { background: #1c212b; border: none; }
