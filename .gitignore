# --- ADIOS build system additions (2026-08-01) ---
# Eclipse/STM32CubeIDE indexer cache (regenerated locally, huge .pdom files)
.metadata/

# Leftover Subversion working-copy metadata from before this became a plain
# folder copy - duplicated content, not useful
.svn/
*/.svn/

# macOS Finder metadata
.DS_Store
._.DS_Store

# Per-project build output directories (make target)
project_build/
*.dd
*.lss
*.sym
*.dep

# Generated linker scripts / boundary headers (etc/gen_bsl_boundary.sh) -
# regenerated on every single make invocation by design, never meant to be
# stable/committed. Fixed names since 2026-08-04 (was per-chip
# "${CHIP}_generated.ld", accumulating stale copies if the target chip
# changed mid-project). Since 2026-08-26 they all live inside project_build/,
# with the rest of the build output: nothing at a project root was ever
# cleaned, since clean is `rm -rf project_build`. The C side finds the
# headers through the -I$(PROJECT_OUT) that common.mk puts on CFLAGS.
cpu_bsl.ld
cpu_app.ld
adios_bsl_boundary.h
gen_bsl_boundary_build.log
# Transient concurrency lock (etc/gen_bsl_boundary.sh) - removed on exit, can
# only survive a hard crash/kill; the script steals a lock whose holder PID
# is dead, so a leftover is harmless either way.
.gen_bsl_boundary.lock/

# Machine-local symlink bootstrapped by gen_bsl_boundary.sh, standing in for
# the repo root in the bootloader's own sub-make so THUMB_SOURCE paths built
# from it never contain a literal ".." (which would otherwise walk object
# files back out of $(PROJECT_OUT) on every build - see that script's
# comment for the full story)
.repo_root

# Compiled bootloader/app binaries/hex files copied out of project_build/
# (regenerable)
*.bin
*.hex

# Embedded bootloader image, written inside project_build/ beside the
# project's own adios_bsl_boundary.h by the same pass of
# etc/gen_bsl_boundary.sh, and rewritten at every build of that project
adios_bsl_image.inc

# Reference-only MIDIbox heritage, kept on disk but out of the repository
# (decided 2026-08-11): modules and LCD drivers that depended on the removed
# adios_board, plus the original MIDIbox application tree. Nothing here is
# built or maintained - it is kept locally to consult, not to carry.
old_midibox_ref_only/

# Editor session files and one-off working documents kept at the root.
# These describe how WE are looking at the tree at a given moment - an open-tab
# list, a survey, an analysis - and say nothing about the firmware. Twice in two
# days such a file left in a commit (tk_report.txt, cases.txt), so they are named
# here rather than remembered.
session notepad
session*.xml
RELIQUATS.md

# Eclipse / CubeIDE per-workspace settings. These describe THIS machine's IDE
# install - toolchain paths, indexer state, and an exported ADIOS_PATH that
# overrides the Makefile's self-location. They are rewritten on every build and
# say nothing about the firmware, so whoever clones must not inherit them.
# The .project / .cproject files DO stay: they describe the project itself.
.settings/

# ---------------------------------------------------------------------------
# Only what is needed to BUILD an application, plus the documentation written
# for whoever uses it. Everything below fails that rule and is kept on disk,
# out of the repository.
# ---------------------------------------------------------------------------

# Vendor documentation and libraries we never compile. The build asks for
# exactly two CMSIS paths per family - CMSIS/Include and
# CMSIS/Device/ST/STM32<family>/Include - and nothing else in that tree is ever
# read: 4400 HTML pages, the DSP library with its Keil/IAR projects and test
# suites, the neural-network library, two RTOS ports.
drivers/*/LL_HAL/CMSIS/docs/
drivers/*/LL_HAL/CMSIS/DSP/
drivers/*/LL_HAL/CMSIS/NN/
drivers/*/LL_HAL/CMSIS/RTOS/
drivers/*/LL_HAL/CMSIS/RTOS2/
*.chm

# A MIDI library for the PC. Nothing in a firmware can use it.
drivers/gnustep/

# IDE project descriptors. Whoever builds under Xcode does not care about the
# CubeIDE files, and the reverse holds too - the Makefile is the only thing
# they have in common. These stay on disk so the local IDE keeps working.
*.project
*.cproject
*.xcodeproj/

# Assembled distribution packages. They are rebuilt from the build output on

# demand and weigh tens of megabytes; only the tester notice beside them is

# source. Committing the zips would put a whole Qt runtime in the history.

apps/Bruno/5x6_display/tools/5x6_upgrader/dist/*

!apps/Bruno/5x6_display/tools/5x6_upgrader/dist/README.txt

# CMake/Ninja build trees and their outputs, for both bench tools. Everything
# here is rebuilt by build-gui.bat / .sh - the built executables, the deployed
# Qt DLLs, the 32-bit dump helper. None of it belongs in the history.
apps/Bruno/5x6_display/tools/5x6_screen/build-gui/
apps/Bruno/5x6_display/tools/5x6_screen/helper/*.exe
apps/Bruno/5x6_display/tools/5x6_screen/helper/*.obj
apps/Bruno/5x6_display/tools/5x6_upgrader/build/
apps/Bruno/5x6_display/tools/5x6_upgrader/build-gui/
apps/Bruno/5x6_display/tools/adios_studio/build-gui/
