/* The charter, shared with the updater, the screen tool and the ROM editor:
   slate ground, inset surfaces darker than what surrounds them, one accent
   blue for the single action that matters. */

QWidget {
    background: #1c212b;
    color: #dfe4ec;
    font-size: 12px;
}

QLabel#dim { color: #8a94a6; }

QGroupBox {
    border: 1px solid #2a2f3a;
    border-radius: 4px;
    margin-top: 10px;
    padding: 8px 8px 8px 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #8a94a6;
}

QComboBox, QSpinBox, QLineEdit {
    background: #161a22;
    border: 1px solid #3d4757;
    border-radius: 2px;
    padding: 3px 8px;
    selection-background-color: #4a7ab8;
}
QComboBox::drop-down { border: none; width: 18px; }
QComboBox QAbstractItemView {
    background: #161a22;
    border: 1px solid #3d4757;
    selection-background-color: #4a7ab8;
}

QListWidget {
    background: #12151c;
    border: 1px solid #2a2f3a;
    border-radius: 3px;
    padding: 2px;
    outline: 0;
}
QListWidget#mono {
    font-family: "Consolas", "Menlo", monospace;
    font-size: 12px;
}
QListWidget::item { padding: 0 2px; }
QListWidget::item:selected { background: #2c4a6e; color: #f2f6fc; }

QPushButton {
    background: #2e3644;
    border: 1px solid #3d4757;
    border-radius: 2px;
    padding: 4px 16px;
}
QPushButton:hover   { background: #39435a; }
QPushButton:pressed { background: #262d38; }
QPushButton:disabled { background: #242a34; border-color: #2e3644; color: #5a6172; }

QPushButton#primary {
    background: #4a7ab8;
    border: 1px solid #5a8ac8;
    color: #f2f6fc;
}
QPushButton#primary:hover    { background: #5686c4; }
QPushButton#primary:pressed  { background: #3d6aa4; }
QPushButton#primary:disabled { background: #2f3a4a; border-color: #34404f; color: #5a6172; }

QPushButton#flat {
    background: transparent;
    border: 1px solid #3d4757;
    color: #b9c1cf;
}
QPushButton#flat:hover { background: #232a35; color: #dfe4ec; }

QProgressBar {
    background: #12151c;
    border: 1px solid #2a2f3a;
    border-radius: 2px;
    height: 14px;
    text-align: center;
    color: #dfe4ec;
}
QProgressBar::chunk { background: #4a7ab8; border-radius: 2px; }

QCheckBox { color: #8a94a6; }

QSplitter::handle { background: #2a2f3a; width: 3px; }

QScrollBar:vertical { background: #12151c; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #3d4757; border-radius: 5px; min-height: 20px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
