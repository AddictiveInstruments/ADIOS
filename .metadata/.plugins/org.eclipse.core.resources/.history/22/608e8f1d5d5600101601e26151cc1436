/* HOST Mode */
void TR5X6_ROM_HOST(void){
	TR5X6_ROM_CS(1);			// ROM Deselect
	TR5X6_ROM_RD();				// ROM Read
	TR5X6_ROM_OE();				// ROM Output enable
	HOST();						// ROM HOST Mode
	TR5X6_ROM_Addr_Set(TR5X6_ROM_HostAddr(rom_bank));
	TR5X6_ROM_CS(0);			// ROM Select
}

