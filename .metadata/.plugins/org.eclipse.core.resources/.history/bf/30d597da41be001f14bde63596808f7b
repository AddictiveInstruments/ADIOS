/* Includes ------------------------------------------------------------------*/
#include "5x6_rom.h"

/* Defines ------------------------------------------------------------------*/

#define ROM_SPI		1
#define ROM_MAX_DELAY	1000

#define ROM_nHOST_PORT 	GPIOB
#define ROM_nHOST_PIN 	LL_GPIO_PIN_4
#define ROM_nWR_PORT 	GPIOB
#define ROM_nWR_PIN 	LL_GPIO_PIN_9
#define ROM_nOE_PORT 	GPIOA
#define ROM_nOE_PIN 	LL_GPIO_PIN_6
#define ROM_nCS_PORT 	GPIOA
#define ROM_nCS_PIN 	LL_GPIO_PIN_12
#define ROM_ADR_PORT 	GPIOC
#define ROM_ADR_PIN 	LL_GPIO_PIN_14
#define ROM_DAT_PORT 	GPIOC
#define ROM_DAT_PIN 	LL_GPIO_PIN_15

#define PROG() 		MIOS32_SYS_STM_PINSET_1(ROM_nHOST_PORT, ROM_nHOST_PIN)
#define HOST() 		MIOS32_SYS_STM_PINSET_0(ROM_nHOST_PORT, ROM_nHOST_PIN)
#define ROM_RD() 	MIOS32_SYS_STM_PINSET_1(ROM_nWR_PORT, ROM_nWR_PIN)
#define ROM_WR() 	MIOS32_SYS_STM_PINSET_0(ROM_nWR_PORT, ROM_nWR_PIN)
#define ROM_OE() 	MIOS32_SYS_STM_PINSET_0(ROM_nOE_PORT, ROM_nOE_PIN)
#define ROM_IE() 	MIOS32_SYS_STM_PINSET_1(ROM_nOE_PORT, ROM_nOE_PIN)
#define ROM_CS(v) 	MIOS32_SYS_STM_PINSET(ROM_nCS_PORT,ROM_nCS_PIN,v)
#define ROM_ADR(v) 	MIOS32_SYS_STM_PINSET(ROM_ADR_PORT,ROM_ADR_PIN,v)
#define ROM_DAT(v) 	MIOS32_SYS_STM_PINSET(ROM_DAT_PORT,ROM_DAT_PIN,v)

/* Prototypes ------------------------------------------------------------------*/
void ROM_Addr_Set(uint32_t address);
void ROM_Data_Set(uint8_t data);
s32 ROM_Data_Get(void);

/* Variables ------------------------------------------------------------------*/

/* ROM init function */
void ROM_Init(void)
{
	// configure GPIO
	LL_GPIO_InitTypeDef GPIO_InitStruct = {0};
	/* GPIO Ports Clock Enable */
	LL_IOP_GRP1_EnableClock(LL_IOP_GRP1_PERIPH_GPIOA);
	LL_IOP_GRP1_EnableClock(LL_IOP_GRP1_PERIPH_GPIOB);

	GPIO_InitStruct.Mode = LL_GPIO_MODE_OUTPUT;
	GPIO_InitStruct.Speed = LL_GPIO_SPEED_FREQ_VERY_HIGH;
	GPIO_InitStruct.OutputType = LL_GPIO_OUTPUT_PUSHPULL;
	GPIO_InitStruct.Pull = LL_GPIO_PULL_NO;

	GPIO_InitStruct.Pin = ROM_nHOST_PIN;
	LL_GPIO_Init(ROM_nHOST_PORT, &GPIO_InitStruct);

	GPIO_InitStruct.Pin = ROM_nWR_PIN;
	LL_GPIO_Init(ROM_nWR_PORT, &GPIO_InitStruct);

	GPIO_InitStruct.Pin = ROM_nOE_PIN;
	LL_GPIO_Init(ROM_nOE_PORT, &GPIO_InitStruct);

	GPIO_InitStruct.Pin = ROM_nCS_PIN;
	LL_GPIO_Init(ROM_nCS_PORT, &GPIO_InitStruct);

	GPIO_InitStruct.Pin = ROM_ADR_PIN;
	LL_GPIO_Init(ROM_ADR_PORT, &GPIO_InitStruct);

	GPIO_InitStruct.Pin = ROM_DAT_PIN;
	LL_GPIO_Init(ROM_DAT_PORT, &GPIO_InitStruct);

	// initialize SPI interface
	// ensure that fast pin drivers are activated
	MIOS32_SPI_IO_Init(ROM_SPI, MIOS32_SPI_PIN_DRIVER_STRONG);

	// init SPI port
	MIOS32_SPI_TransferModeInit(ROM_SPI, MIOS32_SPI_MODE_CLK0_PHASE0, MIOS32_SPI_PRESCALER_128);

	ROM_DAT(1);
	ROM_ADR(1);
	ROM_HOST();
}

/* HOST Mode */
void ROM_HOST(void){
	ROM_CS(1);			// ROM Deselect
	ROM_RD();			// ROM Read
	ROM_OE();			// ROM Output enable
	HOST();				// ROM HOST Mode
	ROM_CS(0);			// ROM Select
}

/* ********* */
s32 ROM_Read(uint32_t address){
	ROM_CS(1);			// ROM Deselect
	ROM_RD();			// ROM Read pin
	ROM_OE();			// ROM Output enable
	ROM_Addr_Set(address);	// Set ROM address
	PROG();				// ROM PROG Mode
	ROM_CS(0);			// ROM Select
	s32 tmpData=ROM_Data_Get();
	ROM_CS(1);			// ROM Deselect
	return tmpData;
}

/* ********* */
ROM_Status ROM_Write(uint32_t address, uint8_t data, uint32_t Timeout){
	ROM_CS(1);			// ROM Deselect
	ROM_WR();			// ROM Write
	ROM_IE();			// ROM Input enable
	PROG();				// ROM PROG Mode
	// start sector erase sequence
	ROM_Addr_Set(0x00005555);
	ROM_Data_Set(0xAA);
	ROM_CS(0);			// ROM Select
	ROM_CS(1);			// ROM Deselect
	ROM_Addr_Set(0x00002AAA);
	ROM_Data_Set(0x55);
	ROM_CS(0);			// ROM Select
	ROM_CS(1);			// ROM Deselect
	ROM_Addr_Set(0x00005555);
	ROM_Data_Set(0xA0);
	ROM_CS(0);			// ROM Select
	ROM_CS(1);			// ROM Deselect
	ROM_Addr_Set(address);
	ROM_Data_Set(data);
	ROM_CS(0);			// ROM Select
	ROM_CS(1);			// ROM Deselect
	// data polling
	ROM_RD();			// ROM Read pin
	ROM_OE();			// ROM Input enable
	s32 tmpData=0;
	MIOS32_DELAY_Wait_uS(4);
	ROM_Status errorcode = ROM_OK;
	s32 tickstart = MIOS32_TIMESTAMP_Init(0);
	while(tmpData!=data){
        /* Timeout management */
		if(MIOS32_TIMESTAMP_Get()>(tickstart+ROM_MAX_DELAY)){
			ROM_CS(1);			// ROM Deselect
			return ROM_TIMEOUT;
        }else{
			ROM_CS(0);			// ROM Select
			tmpData=ROM_Data_Get();
			ROM_CS(1);			// ROM Deselect
			if(tmpData<0)return ROM_ERROR;
        }

	}
	return errorcode;
}

/* ********* */
ROM_Status ROM_Sector_Erase(uint32_t sector, uint32_t Timeout){
	u8 count=0;
	s32 byte[256];
	ROM_CS(1);			// ROM Deselect
	ROM_WR();			// ROM Write
	ROM_IE();			// ROM Input enable
	PROG();				// ROM PROG Mode
	// start sector erase sequence
	ROM_Addr_Set(0x00005555);
	ROM_Data_Set(0xAA);
	ROM_CS(0);			// ROM Select
	ROM_CS(1);			// ROM Deselect
	ROM_Addr_Set(0x00002AAA);
	ROM_Data_Set(0x55);
	ROM_CS(0);			// ROM Select
	ROM_CS(1);			// ROM Deselect
	ROM_Addr_Set(0x00005555);
	ROM_Data_Set(0x80);
	ROM_CS(0);			// ROM Select
	ROM_CS(1);			// ROM Deselect
	ROM_Addr_Set(0x00005555);
	ROM_Data_Set(0xAA);
	ROM_CS(0);			// ROM Select
	ROM_CS(1);			// ROM Deselect
	ROM_Addr_Set(0x00002AAA);
	ROM_Data_Set(0x55);
	ROM_CS(0);			// ROM Select
	ROM_CS(1);			// ROM Deselect
	ROM_Addr_Set(sector);
	ROM_Data_Set(0x30);
	ROM_CS(0);			// ROM Select
	ROM_CS(1);			// ROM Deselect
	// data polling
	ROM_RD();			// ROM Read pin
	ROM_OE();			// ROM Input enable
	s32 tmpData=0;
	MIOS32_DELAY_Wait_uS(4);
	ROM_Status errorcode = ROM_OK;
	s32 tickstart = MIOS32_TIMESTAMP_Init(0);
	while(tmpData!=0xff){
        /* Timeout management */
		if(MIOS32_TIMESTAMP_Get()>(tickstart+ROM_MAX_DELAY)){
			ROM_CS(1);			// ROM Deselect
			return ROM_TIMEOUT;
        }else{
			ROM_CS(0);			// ROM Select
			tmpData=ROM_Data_Get();

			ROM_CS(1);			// ROM Deselect

			byte[count]=tmpData;
			count++;
			//if(tmpData<0)return ROM_ERROR;
        }

	}
	for(int i =0; i<count;i++)MIOS32_MIDI_SendDebugMessage("%08x", byte[i]);
	return errorcode;
}

/* ********* */
void ROM_Addr_Set(uint32_t address){
	// Set ROM address
	ROM_ADR(0);
	address ^= 0x00030000;
	uint8_t tmpAddr[3] = {(address>>16) &0xff,  (address>>8) &0xff, address &0xff};
	//HAL_SPI_Transmit(&hspi2, tmpAddr, 3, 1);
	MIOS32_SPI_TransferBlock(ROM_SPI, tmpAddr, NULL, 3, NULL);
	ROM_ADR(1);

}

/* ********* */
void ROM_Data_Set(uint8_t data){
	ROM_DAT(0);
//	__NOP();__NOP();__NOP();
	//HAL_SPI_Transmit(&hspi2, &data, 1, 1);
	MIOS32_SPI_TransferByte(ROM_SPI, data);
	ROM_DAT(1);
}

/* ********* */
s32 ROM_Data_Get(void){
	ROM_DAT(0);
	MIOS32_DELAY_Wait_uS(1);
	ROM_DAT(1);
	//uint8_t tmpData=0;
	//HAL_SPI_Receive(&hspi2, &tmpData, 1, 1);
	return MIOS32_SPI_TransferByte(ROM_SPI, 0xff);
	//return tmpData;
}

