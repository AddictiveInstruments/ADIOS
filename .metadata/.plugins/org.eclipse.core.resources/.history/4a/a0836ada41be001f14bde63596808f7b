/////////////////////////////////////////////////////////////////////////////
// This hook is called after startup to initialize the application
/////////////////////////////////////////////////////////////////////////////
void APP_Init(void)
{
	// initialize all LEDs
	MIOS32_BOARD_LED_Init(0xffffffff);
	DECOD_Init();
	ROM_Init();

    APP_LCD_Clear();
    APP_TFT_Background();
    tft_ready = 1;
    APP_LCD_Lite(1);

	// start screen printing task
	//xTaskCreate(TASK_TFT_DelayedInit, "TFT_DelayedInit", (configMINIMAL_STACK_SIZE), NULL, PRIORITY_TASK_TFT_HANDLER, &xTFTInit);

	xTaskCreate(TASK_TFT_Periodic, "TFT_Handler", (configMINIMAL_STACK_SIZE), NULL, PRIORITY_TASK_TFT_HANDLER, &xTFTRefresh);

	// Enables MIDI TX bypass for UART0
	MIOS32_UART_TX_Bypass(0, 1);
	ROM_Status errorcode = ROM_OK;
	if((errorcode=ROM_Sector_Erase(0x00000000, 1000))==ROM_OK){
		MIOS32_MIDI_SendDebugMessage("ROM sector erased");
		for(int b=0x0000;b<ROM_SECTOR_SIZE;b++){
			if((errorcode=ROM_Write((u32)b, (u8)b, 1000))==ROM_OK)
				MIOS32_MIDI_SendDebugMessage("ROM address %08x written.", b);
			else MIOS32_MIDI_SendDebugMessage("ROM write error#%d!", errorcode);
		}
	}else MIOS32_MIDI_SendDebugMessage("ROM sector erase error#%d!", errorcode);

}


