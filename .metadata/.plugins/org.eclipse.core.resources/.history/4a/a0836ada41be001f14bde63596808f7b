/////////////////////////////////////////////////////////////////////////////
void TASK_TFT_DelayedInit(void *pvParameters)
{

  while(1)
  {

    vTaskDelay(pdMS_TO_TICKS(1000) );
    APP_LCD_DelayedInit(0);
    APP_LCD_Clear();
    APP_TFT_Background();
    tft_ready = 1;
    APP_LCD_Lite(1);
    vTaskDelete(xTFTInit);
  }
}
