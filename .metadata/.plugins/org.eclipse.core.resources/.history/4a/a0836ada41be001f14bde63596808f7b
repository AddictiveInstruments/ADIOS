/////////////////////////////////////////////////////////////////////////////
// periodically called for screen print
/////////////////////////////////////////////////////////////////////////////
static void TASK_TFT_Periodic(void *pvParameters)
{
	portTickType xLastExecutionTime;

	// Initialise the xLastExecutionTime variable on task entry
	xLastExecutionTime = xTaskGetTickCount();

	while( 1 ) {
		// wait for 20 mS
		//vTaskDelayUntil(&xLastExecutionTime, 20 / portTICK_RATE_MS);
		vTaskDelayUntil(&xLastExecutionTime, 2000 / portTICK_RATE_MS);

		// temp
		s32 data = ROM_Read(address);
		MIOS32_MIDI_SendDebugMessage("data@%08x = %d", address,  data);
		address++;
		if(address>=0x80000)address=0;


		if(tft_ready){
			mios32_lcd_bitmap_t bmp;		//dummy bitmap
			// All Digits
			for(int i=0;i<6;i++){
				if( decod_digits_flags & (1<<i) ){
					decod_digits_flags &= ~(1<<i);
					APP_LCD_Digits_draw(decod_digits[i], x_offset + decod_digits_pos[i], y_offset+197, 1, APP_LCD_WHITE, APP_LCD_BLACK);
				}
			}
			APP_LCD_FontInit((u8*)GLCD_FONT_9BITRPR, Is1BIT);
			// temp for button testing
			if(decod_buttons.dec)APP_LCD_PrintString(bmp, 0, x_offset+100, y_offset+110, 0, APP_LCD_STRING_ALIGN_CENTER, -32, "DEC");
			else APP_LCD_PrintString(bmp, 0, x_offset+100, y_offset+110, 0, APP_LCD_STRING_ALIGN_CENTER, -32, "        ");

			// last step/ dot steps
			for(int i=0; i<16; i++){
				if(decod_last_step_flags &(1<<i)){
					if(decod_last_step &(1<<i))APP_LCD_FColourSet(APP_LCD_WHITE);
					else APP_LCD_FColourSet(APP_LCD_DARKGREY);
					APP_LCD_PrintFormattedString(bmp, 0, x_offset+w_max-359+i*23, y_offset+71, 0, APP_LCD_STRING_ALIGN_CENTER, -32, "%d", (i+1));
				}
				if(decod_step_dots_flags &(1<<i) || decod_last_step_flags &(1<<i)){
					APP_LCD_DrawFastBall(x_offset+w_max-364+i*23, y_offset+46, (decod_step_dots &(1<<i))?((decod_last_step &(1<<i))?APP_LCD_WHITE:APP_LCD_DARKGREY):APP_LCD_BLACK);
				}
			}
			decod_last_step_flags = 0x0000;
			decod_step_dots_flags = 0x0000;
			APP_LCD_FColourSet(APP_LCD_WHITE);
			// Scale
			if(decod_scale_flag){
				decod_scale_flag=0;
				u16 w = 16*23-1;
				u16 scale_y_offset=y_offset +8;

				switch(decod_scale){
				case 0x00:
				case 0x02:
				case 0x07:
				case 0x0e:
					APP_LCD_Rectangle(x_offset+w_max-w, scale_y_offset, w-2, 23, 0, 0, 1, 0);
					break;
				default:
				}
				switch(decod_scale){
				case 0x00:
					APP_LCD_PrintString(bmp, 0, x_offset+47, y_offset+23, 0, APP_LCD_STRING_ALIGN_CENTER, -32, "  1<32  ");
					break;
				case 0x02:
					APP_LCD_PrintString(bmp, 0, x_offset+47, y_offset+23, 0, APP_LCD_STRING_ALIGN_CENTER, -32, "  1<16  ");
					break;
				case 0x07:
					APP_LCD_PrintString(bmp, 0, x_offset+47, y_offset+23, 0, APP_LCD_STRING_ALIGN_CENTER, -32, "1<32T");
					break;
				case 0x0e:
					APP_LCD_PrintString(bmp, 0, x_offset+47, y_offset+23, 0, APP_LCD_STRING_ALIGN_CENTER, -32, "1<16T");
					break;
				default:
				}
				switch(decod_scale){
				case 0x02:
					APP_LCD_DrawFastVLine(x_offset+w_max-4*23+11, scale_y_offset+5, 13, APP_LCD_WHITE);
					APP_LCD_DrawFastNoire(x_offset+w_max-4*23+7, scale_y_offset+18, APP_LCD_WHITE);
					APP_LCD_DrawFastVLine(x_offset+w_max-12*23+11, scale_y_offset+5, 13, APP_LCD_WHITE);
					APP_LCD_DrawFastNoire(x_offset+w_max-12*23+7, scale_y_offset+18, APP_LCD_WHITE);
				case 0x00:
					APP_LCD_DrawFastVLine(x_offset+w_max-8*23+11, scale_y_offset+5, 13, APP_LCD_WHITE);
					APP_LCD_DrawFastNoire(x_offset+w_max-8*23+7, scale_y_offset+18, APP_LCD_WHITE);
					APP_LCD_DrawFastVLine(x_offset+w_max-16*23+11, scale_y_offset+5, 13, APP_LCD_WHITE);
					APP_LCD_DrawFastNoire(x_offset+w_max-16*23+7, scale_y_offset+18, APP_LCD_WHITE);
					break;
				case 0x07:
					for(int i=0; i<2; i++){
						APP_LCD_DrawPixel(x_offset+w_max-(10+i*6)*23+6, scale_y_offset+1, APP_LCD_WHITE);
						APP_LCD_DrawFastHLine(x_offset+w_max-(10+i*6)*23+7, scale_y_offset, 6*23-13, APP_LCD_WHITE);
						APP_LCD_DrawPixel(x_offset+w_max-(4+i*6)*23-6, scale_y_offset+1, APP_LCD_WHITE);
					}
					APP_LCD_DrawPixel(x_offset+w_max-4*23+6, scale_y_offset+1, APP_LCD_WHITE);
					APP_LCD_DrawFastHLine(x_offset+w_max-4*23+7, scale_y_offset, 4*23-13, APP_LCD_WHITE);
					for(int i=1; i<=8; i++){
						APP_LCD_DrawFastCroche(x_offset+w_max-i*46+11, scale_y_offset+5, APP_LCD_WHITE);
						APP_LCD_DrawFastVLine(x_offset+w_max-i*46+10, scale_y_offset+5, 13, APP_LCD_WHITE);
						APP_LCD_DrawFastNoire(x_offset+w_max-i*46+6, scale_y_offset+18, APP_LCD_WHITE);
					}

					break;
				case 0x0e:
					for(int i=0; i<5; i++){
						APP_LCD_DrawPixel(x_offset+w_max-(4+i*3)*23+6, scale_y_offset+1, APP_LCD_WHITE);
						APP_LCD_DrawFastHLine(x_offset+w_max-(4+i*3)*23+7, scale_y_offset, 3*23-13, APP_LCD_WHITE);
						APP_LCD_DrawPixel(x_offset+w_max-(1+i*3)*23-6, scale_y_offset+1, APP_LCD_WHITE);
					}
					APP_LCD_DrawPixel(x_offset+w_max-1*23+6, scale_y_offset+1, APP_LCD_WHITE);
					APP_LCD_DrawFastHLine(x_offset+w_max-1*23+7, scale_y_offset, 1*23-13, APP_LCD_WHITE);
					for(int i=1; i<=16; i++){
						APP_LCD_DrawFastCroche(x_offset+w_max-i*23+11, scale_y_offset+5, APP_LCD_WHITE);
						APP_LCD_DrawFastVLine(x_offset+w_max-i*23+10, scale_y_offset+5, 13, APP_LCD_WHITE);
						APP_LCD_DrawFastNoire(x_offset+w_max-i*23+6, scale_y_offset+18, APP_LCD_WHITE);
					}

					break;
				default:
					break;
				}
			}
			// Labels
			//APP_LCD_FontInit((u8*)GLCD_FONT_9BITRPR, Is1BIT);
			if(decod_labels_flags.tempo || decod_labels_flags.measure){
				APP_LCD_Rectangle(x_offset+93, y_offset+173, 58, 10, 0, 0, 1, 0);
				if(decod_labels.tempo)
					APP_LCD_PrintString(bmp, 0, x_offset+122, y_offset+173, 0, APP_LCD_STRING_ALIGN_CENTER, -32, "TEMPO");
				if(decod_labels.measure)
				APP_LCD_PrintString(bmp, 0, x_offset+122, y_offset+173, 0, APP_LCD_STRING_ALIGN_CENTER, -32, "MEASURE");
			}
			if(decod_labels_flags.grp_pat || decod_labels_flags.level){
				APP_LCD_Rectangle(x_offset+202, y_offset+173, 107, 10, 0, 0, 1, 0);
				if(decod_labels.grp_pat){
					APP_LCD_PrintString(bmp, 0, x_offset+202, y_offset+173, 0, APP_LCD_STRING_ALIGN_LEFT, -32, "GROUP");
					APP_LCD_PrintString(bmp, 0, x_offset+309, y_offset+173, 0, APP_LCD_STRING_ALIGN_RIGHT, -32, "PATTERN");}
				if(decod_labels.level)
					APP_LCD_PrintString(bmp, 0, x_offset+309, y_offset+173, 0, APP_LCD_STRING_ALIGN_RIGHT, -32, "LEVEL");
			}
			if(decod_labels_flags.sync){
				if(decod_labels.sync)
				APP_LCD_PrintString(bmp, 0, x_offset+122, y_offset+262, 0, APP_LCD_STRING_ALIGN_CENTER, -32, "MIDI  SYNC");
			else APP_LCD_Rectangle(x_offset+82, y_offset+262, 80, 10, 0, 0, 1, 0);
			}
			if(decod_labels_flags.chain){
				if(decod_labels.chain)
				APP_LCD_PrintString(bmp, 0, x_offset+232, y_offset+262, 0, APP_LCD_STRING_ALIGN_CENTER, -32, "CHAIN");
			else APP_LCD_Rectangle(x_offset+212, y_offset+262, 40, 10, 0, 0, 1, 0);
			}
			if(decod_labels_flags.block){
				if(decod_labels.block)
				APP_LCD_PrintString(bmp, 0, x_offset+278, y_offset+262, 0, APP_LCD_STRING_ALIGN_CENTER, -32, "BLOCK");
			else APP_LCD_Rectangle(x_offset+258, y_offset+262, 40, 10, 0, 0, 1, 0);
			}
			decod_labels_flags.ALL = 0;
			// Mode
#ifndef REDUCED_APP_LCD
			APP_LCD_FontInit((u8*)GLCD_FONT_PIXEL12X10, Is1BIT);
			if(decod_mode_flag){
				decod_mode_flag=0;
				switch(decod_mode){
				case 0x01:
				case 0x02:
				case 0x04:
				case 0x08:
				case 0x10:
					APP_LCD_Rectangle(x_offset+355, y_offset+200, 76, 16, 0, 0, 1, 0);
					APP_LCD_Rectangle(x_offset+368, y_offset+217, 51, 16, 0, 0, 1, 0);
					break;
				default:
					break;
				}
				switch(decod_mode){
				case 0x01:
					APP_LCD_PrintString(bmp, 0, x_offset+393, y_offset+200, 0, APP_LCD_STRING_ALIGN_CENTER, -48, "TRACK");
					APP_LCD_PrintString(bmp, 0, x_offset+393, y_offset+217, 0, APP_LCD_STRING_ALIGN_CENTER, -48, "PLAY");
					break;
				case 0x02:
					APP_LCD_PrintString(bmp, 0, x_offset+393, y_offset+200, 0, APP_LCD_STRING_ALIGN_CENTER, -48, "PATTERN");
					APP_LCD_PrintString(bmp, 0, x_offset+393, y_offset+217, 0, APP_LCD_STRING_ALIGN_CENTER, -48, "PLAY");
					break;
				case 0x04:
					APP_LCD_PrintString(bmp, 0, x_offset+393, y_offset+200, 0, APP_LCD_STRING_ALIGN_CENTER, -48, "TRACK");
					APP_LCD_PrintString(bmp, 0, x_offset+393, y_offset+217, 0, APP_LCD_STRING_ALIGN_CENTER, -48, "WRITE");
					break;
				case 0x08:
					APP_LCD_PrintString(bmp, 0, x_offset+393, y_offset+200, 0, APP_LCD_STRING_ALIGN_CENTER, -48, "STEP");
					APP_LCD_PrintString(bmp, 0, x_offset+393, y_offset+217, 0, APP_LCD_STRING_ALIGN_CENTER, -48, "WRITE");
					break;
				case 0x10:
					APP_LCD_PrintString(bmp, 0, x_offset+393, y_offset+200, 0, APP_LCD_STRING_ALIGN_CENTER, -48, "TAP");
					APP_LCD_PrintString(bmp, 0, x_offset+393, y_offset+217, 0, APP_LCD_STRING_ALIGN_CENTER, -48, "WRITE");
					break;
				default:
					break;
				}
			}
			// Group
			if(decod_group_flag){
				decod_group_flag=0;
				switch(decod_group){
				case 0x01:
					APP_LCD_PrintString(bmp, 0, x_offset+221, y_offset+200, 0, APP_LCD_STRING_ALIGN_CENTER, -48, "A");
					break;
				case 0x02:
					APP_LCD_PrintString(bmp, 0, x_offset+221, y_offset+200, 0, APP_LCD_STRING_ALIGN_CENTER, -48, "B");
					break;
				case 0x04:
					APP_LCD_PrintString(bmp, 0, x_offset+221, y_offset+200, 0, APP_LCD_STRING_ALIGN_CENTER, -48, "C");
					break;
				case 0x08:
					APP_LCD_PrintString(bmp, 0, x_offset+221, y_offset+200, 0, APP_LCD_STRING_ALIGN_CENTER, -48, "D");
					break;
				case 0x10:
					APP_LCD_PrintString(bmp, 0, x_offset+221, y_offset+200, 0, APP_LCD_STRING_ALIGN_CENTER, -48, "E");
					break;
				case 0x20:
					APP_LCD_PrintString(bmp, 0, x_offset+221, y_offset+200, 0, APP_LCD_STRING_ALIGN_CENTER, -48, "F");
					break;
				default:
					APP_LCD_Rectangle(x_offset+212, y_offset+200, 20, 13, 0, 0, 1, 0);
					break;
				}
			}
#endif
			// MIDI activity
			u8 act=MIOS32_UART_RXTX_Act();
			if(act&0x01)APP_LCD_Rectangle(x_offset+335, y_offset+262, 11, 11, 1, APP_LCD_DARKGREY, 2, APP_LCD_RED);
			else APP_LCD_Rectangle(x_offset+335, y_offset+262, 11, 11, 1, APP_LCD_DARKGREY, 1, 0);
			if(act&0x10)APP_LCD_Rectangle(x_offset+441, y_offset+249, 11, 11, 1, APP_LCD_DARKGREY, 2, APP_LCD_RED);
			else APP_LCD_Rectangle(x_offset+441, y_offset+249, 11, 11, 1, APP_LCD_DARKGREY, 1, 0);
			if(act&0x02)APP_LCD_Rectangle(x_offset+441, y_offset+262, 11, 11, 1, APP_LCD_DARKGREY, 2, APP_LCD_RED);
			else APP_LCD_Rectangle(x_offset+441, y_offset+262, 11, 11, 1, APP_LCD_DARKGREY, 1, 0);
		}
	}
}

