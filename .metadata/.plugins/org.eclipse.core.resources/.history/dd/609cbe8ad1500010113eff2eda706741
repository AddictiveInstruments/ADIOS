/////////////////////////////////////////////////////////////////////////////
// periodically called for screen print
/////////////////////////////////////////////////////////////////////////////
static void TASK_ROM_Periodic(void *pvParameters)
{
	portTickType xLastExecutionTime;

	// Initialise the xLastExecutionTime variable on task entry
	xLastExecutionTime = xTaskGetTickCount();

	while( 1 ) {
		// wait for 20 mS
		//vTaskDelayUntil(&xLastExecutionTime, 20 / portTICK_RATE_MS);
		vTaskDelayUntil(&xLastExecutionTime, 80 / portTICK_RATE_MS);
		//MIOS32_IRQ_Disable();
		// request SPI access
		//MUTEX_SPI_TAKE;
		MIDIO_SYSEX_Cmd_WriteInfoRequest();
		MIDIO_SYSEX_Cmd_WriteBlockRequest();
		// request SPI access
		//MUTEX_SPI_GIVE;
		//MIOS32_IRQ_Enable();
		if(tr5x6_xfer_state.STAT==XFER_ERROR){
			xfer_delay=20;
			tr5x6_xfer_state.STAT=XFER_IDLE;
			tr5x6_xfer_state.FLAG=1;
		}
		if(tr5x6_xfer_state.STAT==XFER_END) {
			if(tr5x6_xfer_state.FLAG==1){
				xfer_delay=16;
				//MIOS32_MIDI_SendDebugMessage("start delay\n");
			}
		}

	}
}


