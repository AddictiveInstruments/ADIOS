static void TFT_XferProgress(u8 _progress)
{
	u8 xfer_bmp_array[xfer_bmp_size];
	for(int i =0; i<xfer_bmp_size; i++)xfer_bmp_array[i] = 0x00;
	mios32_lcd_bitmap_t xfer_bmp = APP_LCD_BitmapInit((u8*)xfer_bmp_array, xfer_bmp_width, 40, xfer_bmp_width, Is1BIT);
	//memset(sysex_bmp.memory, 0x00, size);

	// prints messages in bitmap
	APP_LCD_BitmapPrintFormattedString(xfer_bmp, 1.0, (s16)(xfer_bmp_width/2), 5, 0, APP_LCD_STRING_ALIGN_CENTER, -32, "Bank%u/Slot%u", MIDIO_SYSEX_CurrentBank()+1, MIDIO_SYSEX_CurrentSlot()+1);
	APP_LCD_BitmapPrintFormattedString(xfer_bmp, 1.0, (s16)(xfer_bmp_width/2), 24, 0, APP_LCD_STRING_ALIGN_CENTER, -32, "%u%s", _progress, (_progress==100)?"% received.":"% ...");
	if(_progress!=101){
		//APP_LCD_FColourSet(APP_LCD_WHITE);
		APP_LCD_PrintProgress(xfer_bmp, 0x603030, x_offset+w_max-4-xfer_bmp_width, y_offset+95, xfer_bmp_width, 5*8, xfer_bmp_width*_progress/100);   // new
	}else{
		//APP_LCD_FColourSet(APP_LCD_RED);
		  for (int w=0; w<xfer_bmp_width;w++){
			  u8* bmp_mem_ptr = xfer_bmp.memory +w;
			  mios32_lcd_bitmap_t bmp2print = APP_LCD_BitmapInit(bmp_mem_ptr, 1, 40, xfer_bmp_width, Is1BIT);
			  APP_LCD_SendBitmap(bmp2print, x_offset+w_max-4-xfer_bmp_width+w, y_offset+95);
		  }
	}
	APP_LCD_FColourSet(APP_LCD_WHITE);
}

/////////////////////////////////////////////////////////////////////////////
// periodically called for screen print
/////////////////////////////////////////////////////////////////////////////
static void TASK_TFT_Periodic(void *pvParameters)
{
	portTickType xLastExecutionTime;

	// Initialise the xLastExecutionTime variable on task entry
	xLastExecutionTime = xTaskGetTickCount();

	while( 1 ) {
		// wait for 20 mS
		//vTaskDelayUntil(&xLastExecutionTime, 20 / portTICK_RATE_MS);
		vTaskDelayUntil(&xLastExecutionTime, 40 / portTICK_RATE_MS);

		// request SPI access
		//MUTEX_SPI_TAKE;
		if(tft_ready){

			mios32_lcd_bitmap_t bmp;		//dummy bitmap
			u8 newId_flag=0;

#if TR5X6_UNIT_SELECT==505
			// look for sound bank change inhibit
			if(tr5x6_decod_labels.level || tr5x6_decod_labels.sync
					|| (tr5x6_decod_digits[3]==0x72) || (tr5x6_decod_digits[3]==0x62) || (tr5x6_decod_digits[3]==0x60)){
				bank_change_inhibit=1;
			}else{
				bank_change_inhibit=0;
			}

#if 1
			// Catch the Basic Channel of the unit(Sysex Device ID).
			//if(tr5x6_decod_digits_flags){
			if((tr5x6_decod_digits[1]==0x60) && (tr5x6_decod_digits[2]==0x64) && (tr5x6_decod_digits[3]==0x72)){
				u8 devId = 0;
				if((tr5x6_decod_digits[4]==0x00) || (tr5x6_decod_digits[4]==0x03)){
					if(tr5x6_decod_digits[4]==0x03)devId += 10;
					switch(tr5x6_decod_digits[5]){
					case 0x03: devId += 1; break;
					case 0x6d: devId += 2; break;
					case 0x2f: devId += 3; break;
					case 0x33: devId += 4; break;
					case 0x3e: devId += 5; break;
					case 0x7e: devId += 6; break;
					case 0x0b: devId += 7; break;
					case 0x7f: devId += 8; break;
					case 0x3f: devId += 9; break;
					}
					devId --;
					if(newID_old!=devId){
						newID_cnt=0;
