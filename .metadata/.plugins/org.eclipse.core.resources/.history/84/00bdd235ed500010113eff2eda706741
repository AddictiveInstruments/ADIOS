#ifndef _MIDIO_SYSEX_H
#define _MIDIO_SYSEX_H

/////////////////////////////////////////////////////////////////////////////
// global definitions
/////////////////////////////////////////////////////////////////////////////


/////////////////////////////////////////////////////////////////////////////
// Type definitions
/////////////////////////////////////////////////////////////////////////////
typedef enum{
	XFER_IDLE=0,
	XFER_END,
	XFER_BEGIN,
	XFER_CONT,
	XFER_ERROR
}tr5x6_xfer_status;

typedef union {
	struct {
		u8 ALL;
	};
	struct {
		u8 STAT:3;
		u8 :1;
		u8 :1;
		u8 :1;
		u8 :1;
		u8 FLAG:1;
	};
} tr5x6_xfer_state_t;

